{
  "name": "dduo-solo-founder",
  "version": "0.2.0-beta.1",
  "description": "Shared sleep-consolidated project memory, versioned plans, tasks, and encrypted recovery for Claude Code",
  "author": {"name": "dDuo Solo Founder contributors"},
  "license": "Apache-2.0",
  "mcpServers": {
    "dduo-solo-founder": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/agent-plugin-mcp.mjs"],
      "env": {
        "DDUO_SOLO_FOUNDER_CLIENT": "claude",
        "DDUO_SOLO_FOUNDER_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agent-plugin-hook.mjs\" session-start", "timeout": 200, "statusMessage": "Loading dDuo Solo Founder project memory..."}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agent-plugin-hook.mjs\" prompt", "timeout": 60}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/agent-plugin-hook.mjs\" stop", "timeout": 20}]}
    ]
  }
}
